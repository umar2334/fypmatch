# Required in production. Create a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. Any Gemini model available to your key.
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional. Public URL, used for canonical links and social previews.
NEXT_PUBLIC_SITE_URL=

# Optional. Shown in the footer and on the pricing page when set.
NEXT_PUBLIC_CONTACT_EMAIL=

# Tests only. Serves labelled sample ideas instead of calling Gemini.
# Ignored on Vercel production deployments.
MOCK_AI=
